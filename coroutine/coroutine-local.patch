+// Lets an embedder run a shared isolate's microtasks one job at a time, each on
+// the coroutine of its choice: a job that suspends then holds up no other job.
+
+namespace {
+
+intptr_t& QueueField(v8::internal::MicrotaskQueue* queue, size_t offset) {
+  return *reinterpret_cast<intptr_t*>(reinterpret_cast<uintptr_t>(queue) +
+                                      offset);
+}
+
+}  // namespace
+
+size_t v8_coroutine_microtask_count(void* v8_isolate) {
+  auto* isolate = reinterpret_cast<v8::internal::Isolate*>(v8_isolate);
+  return static_cast<size_t>(isolate->default_microtask_queue()->size());
+}
+
+intptr_t v8_coroutine_microtask_peek(void* v8_isolate) {
+  auto* isolate = reinterpret_cast<v8::internal::Isolate*>(v8_isolate);
+  v8::internal::MicrotaskQueue* queue = isolate->default_microtask_queue();
+  if (queue->size() == 0) return -1;
+#ifdef V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA
+  v8::internal::Tagged<v8::internal::Object> data =
+      queue->get(0)->continuation_preserved_embedder_data();
+  if (v8::internal::IsSmi(data)) return v8::internal::Smi::ToInt(data);
+#endif
+  return 0;
+}
+
+int v8_coroutine_microtask_take(void* v8_isolate, void* to, intptr_t* owner) {
+  using v8::internal::MicrotaskQueue;
+  auto* isolate = reinterpret_cast<v8::internal::Isolate*>(v8_isolate);
+  MicrotaskQueue* from = isolate->default_microtask_queue();
+  auto* target = static_cast<MicrotaskQueue*>(static_cast<v8::MicrotaskQueue*>(to));
+  // A job may only move into an idle, empty queue, and none runs once the
+  // isolate is terminating.
+  if (target->size() != 0 || target->IsRunningMicrotasks()) return -1;
+  if (from->size() == 0 || isolate->is_execution_terminating()) return 0;
+  v8::internal::Tagged<v8::internal::Microtask> job = from->get(0);
+  QueueField(from, MicrotaskQueue::kStartOffset) =
+      (from->start() + 1) % from->capacity();
+  QueueField(from, MicrotaskQueue::kSizeOffset) = from->size() - 1;
+  target->EnqueueMicrotask(job);
+  *owner = 0;
+#ifdef V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA
+  v8::internal::Tagged<v8::internal::Object> data =
+      job->continuation_preserved_embedder_data();
