@@ -12742,6 +12743,347 @@ std::string SourceLocation::ToString() const {
 
 }  // namespace v8
 
+// ---------------------------------------------------------------------------
+// Object shapes for embedders.
+//
+// A shape is a cached fast-property Map built from a chosen prototype (null
+// included) and a fixed list of property names, plus the field index of every
+// property. An object allocated from a shape needs no name hashing and no map
+// transition per property: the fill loop writes each value at its own field
+// index. That is the `putDirectOffset` path JSC gives Bun's SQLite rows, and
+// it is the one fast-object layout the public API cannot express, because
+// `Object.create(null)` normalises and `Object.setPrototypeOf` cannot hand out
+// the map it produces.
+//
+// An embedder owns a shape, may allocate any number of objects from it on the
+// isolate's thread, and must release it with v8_object_shape_release() before
+// the isolate is disposed. The V8 map is held through a Global handle of a
+// template object, so it survives every GC. No thread state is involved.
+//
+// These are the C entry points v8-coroutine-sys binds as its ObjectShape;
+// a handle here is the tagged pointer a v8::Local stores.
+
+namespace {
+
+namespace i = v8::internal;
+
+struct V8ObjectShape {
+  // Keeps the shape's Map, its descriptor array and its field types alive.
+  v8::Global<v8::Object> holder;
+  // One entry per name, in the order the names were given.
+  std::vector<i::FieldIndex> fields;
+};
+
+inline v8::Local<v8::Value> ShapeValue(const void* handle) {
+  return *reinterpret_cast<const v8::Local<v8::Value>*>(&handle);
+}
+
+inline v8::Local<v8::String> ShapeString(const void* handle) {
+  return *reinterpret_cast<const v8::Local<v8::String>*>(&handle);
+}
+
+}  // namespace
+
+extern "C" {
+
+// Builds a shape, or returns null when the names cannot be a fast map: no
+// names, 128 names or more (V8's map cache boundary), an array-index name, a
+// repeated name, or a field that would not fit in the object body.
+void* v8_object_shape_new(void* v8_isolate, const void* prototype_or_null,
+                          const void* const* names, size_t count) {
+  auto* isolate = static_cast<v8::Isolate*>(v8_isolate);
+  auto* isolate_internal = reinterpret_cast<i::Isolate*>(isolate);
+  if (count == 0 ||
+      count >= static_cast<size_t>(i::JSObject::kMapCacheSize)) {
+    return nullptr;
+  }
+
+  std::vector<i::FieldIndex> fields;
+  fields.reserve(count);
+
+  v8::HandleScope scope(isolate);
+
+  // The map cache's map has `count` in-object slots; the copy is private to
+  // this shape, so the prototype and the fields below cannot affect literals.
+  i::Handle<i::Map> cached =
+      isolate_internal->factory()->ObjectLiteralMapFromCache(
+          isolate_internal->native_context(), static_cast<int>(count));
+  if (cached->is_dictionary_map()) return nullptr;
+  i::Handle<i::Map> map = i::Map::CopyInitialMap(
+      isolate_internal, cached, cached->instance_size(),
+      cached->GetInObjectProperties(), cached->UnusedPropertyFields());
+  // A shape map never shrinks its in-object area after allocations.
+  map->set_construction_counter(i::Map::kNoSlackTracking);
+
+  i::DirectHandle<i::JSPrototype> prototype;
+  if (prototype_or_null == nullptr) {
+    if (!i::TryCast(i::direct_handle(
+                        i::ReadOnlyRoots(isolate_internal).null_value(),
+                        isolate_internal),
+                    &prototype)) {
+      return nullptr;
+    }
+  } else if (!i::TryCast(
+                 v8::Utils::OpenDirectHandle(*ShapeValue(prototype_or_null)),
+                 &prototype)) {
+    return nullptr;
+  }
+  i::Map::SetPrototype(isolate_internal, map, prototype);
+
+  for (size_t k = 0; k < count; k++) {
+    i::DirectHandle<i::String> name =
+        isolate_internal->factory()->InternalizeString(
+            v8::Utils::OpenDirectHandle(*ShapeString(names[k])));
+    uint32_t index;
+    if (name->AsArrayIndex(&index)) return nullptr;
+    if (map->instance_descriptors()
+            ->Search(*name, map->NumberOfOwnDescriptors())
+            .is_found()) {
+      return nullptr;
+    }
+    i::MaybeHandle<i::Map> next = i::Map::CopyWithField(
+        isolate_internal, map, name, i::FieldType::Any(isolate_internal),
+        i::NONE, i::PropertyConstness::kMutable, i::Representation::Tagged(),
+        i::OMIT_TRANSITION);
+    if (!next.ToHandle(&map)) return nullptr;
+    i::FieldIndex field = i::FieldIndex::ForDescriptor(
+        *map, i::InternalIndex(map->NumberOfOwnDescriptors() - 1));
+    // Without an in-object slot the object would need a property array that
+    // NewJSObjectFromMap does not allocate.
+    if (!field.is_inobject()) return nullptr;
+    fields.push_back(field);
+  }
+
+  auto* shape = new V8ObjectShape();
+  shape->holder.Reset(
+      isolate,
+      v8::Utils::ToLocal(isolate_internal->factory()->NewJSObjectFromMap(map)));
+  shape->fields = std::move(fields);
+  return shape;
+}
+
+void v8_object_shape_release(void* shape) {
+  delete static_cast<V8ObjectShape*>(shape);
+}
+
+size_t v8_object_shape_field_count(const void* shape) {
+  return static_cast<const V8ObjectShape*>(shape)->fields.size();
+}
+
+// Bulk form: builds `rows` objects in one call from a cell plan, which is the
+// shape a table reader produces: one kind byte per cell in row-major order
+// (0 = null, 1 = a number from `numbers`, 2 = the next handle from `values`),
+// one field index per column in `fields`, and the numbers and handles those
+// kinds name. Returns the array of rows, or null when the sizes disagree.
+//
+// The loop runs here rather than in the embedder because a per-row call would
+// put one handle per row in the caller's scope, and every scavenge then walks
+// them; this function keeps a handle scope per chunk of rows, so the only roots
+// are the array and the objects already in it.
+const void* v8_object_shape_new_objects(void* v8_isolate,
+                                        const void* shape_ptr,
+                                        const uint32_t* fields,
+                                        size_t columns, const uint8_t* kinds,
+                                        const double* numbers,
+                                        const void* const* values,
+                                        size_t value_count, size_t rows) {
+  auto* isolate = static_cast<v8::Isolate*>(v8_isolate);
+  auto* isolate_internal = reinterpret_cast<i::Isolate*>(isolate);
+  auto* shape = static_cast<const V8ObjectShape*>(shape_ptr);
+  if (columns == 0) return nullptr;
+  for (size_t column = 0; column < columns; column++) {
+    if (fields[column] >= shape->fields.size()) return nullptr;
+  }
+
+  i::DirectHandle<i::JSReceiver> holder = v8::Utils::OpenDirectHandle(
+      *shape->holder.Get(isolate));
+  i::DirectHandle<i::Map> map(
+      i::Cast<i::Map>(holder->map()), isolate_internal);
+  i::ReadOnlyRoots roots(isolate_internal);
+
+  v8::EscapableHandleScope scope(isolate);
+  if (rows == 0) return *scope.Escape(v8::Array::New(isolate, 0));
+  i::DirectHandle<i::FixedArray> elements =
+      isolate_internal->factory()->NewFixedArray(static_cast<int>(rows),
+                                                 i::AllocationType::kYoung);
+  size_t next_value = 0;
+  constexpr size_t kChunkRows = 4096;
+  for (size_t start = 0; start < rows; start += kChunkRows) {
+    v8::HandleScope chunk_scope(isolate);
+    size_t end = std::min(start + kChunkRows, rows);
+    for (size_t row = start; row < end; row++) {
+      i::DirectHandle<i::JSObject> object =
+          isolate_internal->factory()->NewJSObjectFromMap(map);
+      const size_t base = row * columns;
+      bool young = i::HeapLayout::InYoungGeneration(*object);
+      auto put = [&](i::FieldIndex field, i::Tagged<i::Object> value) {
+        if (young) {
+          object->RawFastInobjectPropertyAtPut(field, value,
+                                               i::SKIP_WRITE_BARRIER_SCOPE);
+        } else {
+          object->RawFastInobjectPropertyAtPut(field, value,
+                                               i::UPDATE_WRITE_BARRIER);
+        }
+      };
+      for (size_t column = 0; column < columns; column++) {
+        i::Tagged<i::Object> value;
+        switch (kinds[base + column]) {
+          case 0:
+            value = roots.null_value();
+            break;
+          case 1: {
+            double number = numbers[base + column];
+            int smi = 0;
+            if (i::DoubleToSmiInteger(number, &smi)) {
+              value = i::Smi::FromInt(smi);
+            } else {
+              value = *isolate_internal->factory()->NewNumber(number);
+              young = i::HeapLayout::InYoungGeneration(*object);
+            }
+            break;
+          }
+          default:
+            if (next_value >= value_count) return nullptr;
+            value = *v8::Utils::OpenDirectHandle(*ShapeValue(values[next_value]));
+            next_value++;
+            break;
+        }
+        put(shape->fields[fields[column]], value);
+      }
+      if (i::HeapLayout::InYoungGeneration(*elements)) {
+        elements->set(static_cast<int>(row), *object,
+                      i::SKIP_WRITE_BARRIER_SCOPE);
+      } else {
+        elements->set(static_cast<int>(row), *object, i::UPDATE_WRITE_BARRIER);
+      }
+    }
+  }
+  i::DirectHandle<i::JSArray> array =
+      isolate_internal->factory()->NewJSArrayWithElements(
+          elements, i::PACKED_ELEMENTS, static_cast<int>(rows));
+  return *scope.Escape(v8::Utils::ToLocal(array));
+}
+
+// Allocates one object from the shape and fills every field, or returns null
+// when `count` does not match the shape.
+const void* v8_object_shape_new_object(void* v8_isolate, const void* shape_ptr,
+                                       const void* const* values,
+                                       size_t count) {
+  auto* isolate = static_cast<v8::Isolate*>(v8_isolate);
+  auto* isolate_internal = reinterpret_cast<i::Isolate*>(isolate);
+  auto* shape = static_cast<const V8ObjectShape*>(shape_ptr);
+  if (count != shape->fields.size()) return nullptr;
+
+  i::DirectHandle<i::JSReceiver> holder = v8::Utils::OpenDirectHandle(
+      *shape->holder.Get(isolate));
+  i::DirectHandle<i::JSObject> object =
+      isolate_internal->factory()->NewJSObjectFromMap(
+          i::direct_handle(holder->map(), isolate_internal));
+  {
+    i::DisallowGarbageCollection no_gc;
+    for (size_t k = 0; k < count; k++) {
+      object->RawFastInobjectPropertyAtPut(
+          shape->fields[k],
+          *v8::Utils::OpenDirectHandle(*ShapeValue(values[k])),
+          i::UPDATE_WRITE_BARRIER);
+    }
+  }
+  return *v8::Utils::ToLocal(object);
+}
+
+}  // extern "C"
+
 #ifdef ENABLE_SLOW_DCHECKS
 EXPORT_CONTEXTUAL_VARIABLE(i::StackAllocatedCheck)
 #endif
+
+// ---------------------------------------------------------------------------
+// V8's own trace events for an embedder's trace file.
+//
+// V8 emits TRACE_EVENT records (GC phases, compilation, execution) through the
+// platform's TracingController. A default platform's controller has no buffer,
+// so every category reads as disabled. These entry points give it a ring buffer
+// whose JSON writer appends to a string, start and stop recording a category
+// list, and hand the text back. The controller must be libplatform's, which is
+// what v8::platform::NewDefaultPlatform creates. v8-coroutine-sys binds them
+// as its trace module.
+
+namespace {
+
+struct V8TraceState {
+  std::ostringstream out;
+  v8::platform::tracing::TraceBuffer* buffer = nullptr;
+  std::string taken;
+};
+
+V8TraceState* TraceState() {
+  static V8TraceState* state = new V8TraceState();
+  return state;
+}
+
+v8::platform::tracing::TracingController* TraceController() {
+  return static_cast<v8::platform::tracing::TracingController*>(
+      v8::internal::V8::GetCurrentPlatform()->GetTracingController());
+}
+
+}  // namespace
+
+extern "C" {
+
+// Records the given categories (replacing any earlier list). Returns 1 when
+// recording started, 0 when the platform has no libplatform controller.
+int v8_trace_start(const char* const* categories, size_t count) {
+  if (v8::internal::V8::GetCurrentPlatform() == nullptr) return 0;
+  auto* controller = TraceController();
+  if (controller == nullptr) return 0;
+  V8TraceState* state = TraceState();
+  if (state->buffer == nullptr) {
+    auto* writer =
+        v8::platform::tracing::TraceWriter::CreateJSONTraceWriter(state->out);
+    state->buffer =
+        v8::platform::tracing::TraceBuffer::CreateTraceBufferRingBuffer(
+            8192, writer);
+    // The controller owns the buffer for the rest of the process.
+    controller->Initialize(state->buffer);
+  }
+  auto* config = new v8::platform::tracing::TraceConfig();
+  config->SetTraceRecordMode(v8::platform::tracing::RECORD_CONTINUOUSLY);
+  for (size_t i = 0; i < count; i++) config->AddIncludedCategory(categories[i]);
+  controller->StartTracing(config);
+  return 1;
+}
+
+// V8's trace clock now, in microseconds: the timestamps of the events v8_trace_take returns.
+int64_t v8_trace_now_us() {
+  return v8::base::TimeTicks::Now().ToInternalValue();
+}
+
+// Stops recording; what was recorded stays for v8_trace_take.
+void v8_trace_stop() {
+  V8TraceState* state = TraceState();
+  if (state->buffer == nullptr) return;
+  TraceController()->StopTracing();
+}
+
+// Moves the events recorded so far into the string `*data` points at (valid
+// until the next call) as comma-separated JSON objects, and returns its
+// length. While recording, the buffer is flushed first.
+size_t v8_trace_take(const char** data) {
+  V8TraceState* state = TraceState();
+  if (state->buffer == nullptr) {
+    *data = "";
+    return 0;
+  }
+  state->buffer->Flush();
+  std::string text = state->out.str();
+  state->out.str("");
+  state->out.clear();
+  const std::string head = "{\"traceEvents\":[";
+  if (text.compare(0, head.size(), head) == 0) text.erase(0, head.size());
+  if (!text.empty() && text[0] == ',') text.erase(0, 1);
+  state->taken = std::move(text);
+  *data = state->taken.data();
+  return state->taken.size();
+}
+
+}  // extern "C"
