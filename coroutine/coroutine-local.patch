+  v8::internal::Tagged<v8::internal::Object> data =
+      owner == 0 ? v8::internal::Tagged<v8::internal::Object>(
+                       v8::internal::ReadOnlyRoots(isolate).undefined_value())
+                 : v8::internal::Tagged<v8::internal::Object>(
+                       v8::internal::Smi::FromInt(static_cast<int>(owner)));
+  isolate->isolate_data()->set_continuation_preserved_embedder_data(data);
+#endif
