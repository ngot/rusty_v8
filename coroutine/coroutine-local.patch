+
+namespace {
+static_assert(kPerThreadAsserts == 0);
+thread_local uintptr_t thread_table[kCoroutineSlotCount] = {
+    kInitialPerThreadAsserts};
+}  // namespace
+
+uintptr_t* ThreadTable() { return thread_table; }
+
+}  // namespace v8_coroutine
+
+int v8_coroutine_patch_version() {
+  return V8_COROUTINE_PATCH_VERSION;
+}
+
+size_t v8_coroutine_slot_count() { return v8_coroutine::kCoroutineSlotCount; }
+
+void v8_coroutine_slots_init(uintptr_t* slots, void* stack_start,
+                                  void* stack_limit) {
+  for (int i = 0; i < v8_coroutine::kCoroutineSlotCount; i++) slots[i] = 0;
+  slots[v8_coroutine::kPerThreadAsserts] = v8_coroutine::kInitialPerThreadAsserts;
+  slots[v8_coroutine::kStackStart] = reinterpret_cast<uintptr_t>(stack_start);
+  slots[v8_coroutine::kReservedStackLimit] = reinterpret_cast<uintptr_t>(stack_limit);
+}
+
+void v8_coroutine_slots_use(uintptr_t* slots) {
+  v8_coroutine::g_active_coroutine_slots = slots;
+}
