new file mode 100644
index 00000000..01335413
--- /dev/null
+++ w/src/base/coroutine-local.h
@@ -0,0 +1,123 @@
+// Copyright 2026 the v8-coroutine authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Per-coroutine storage for V8's thread state.
+//
+// An embedder may run many stackful coroutines on one OS thread, each holding
+// its own v8::Locker on a shared isolate. V8 identifies a thread's execution
+// state (Locker owner, archived ThreadLocalTop, handle scopes, stack guard,
+// stack bounds) through a few thread_locals; those are declared as
+// CoroutineLocal<T> instead. Each value lives in the slot table of the running
+// coroutine, which the embedder selects with v8_coroutine_slots_use().
+// A thread that is not running a coroutine uses its own table.
+
+#ifndef V8_BASE_COROUTINE_LOCAL_H_
+#define V8_BASE_COROUTINE_LOCAL_H_
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <type_traits>
+
+#include "src/base/base-export.h"
+
+// Bumped whenever the table layout or the exported functions change.
+#define V8_COROUTINE_PATCH_VERSION 13
+
+namespace v8_coroutine {
+
+// Table index of each per-coroutine value. Every entry starts as zero except
+// kPerThreadAsserts, which must stay first (see ThreadTable()).
+enum CoroutineSlot : int {
+  kPerThreadAsserts,
+  kThreadId,
+  kCurrentIsolate,
+  kCurrentPerIsolateThreadData,
+  kCurrentLocalHeap,
+  kStackStart,
+  kReservedStackLimit,
+  kCoroutineSlotCount
+};
+
+// Initial value of kPerThreadAsserts: v8::internal's kInitialValue, checked by
+// a static_assert in src/common/assert-scope.cc.
+inline constexpr uintptr_t kInitialPerThreadAsserts = 0xFFFFFFDFu;
+
+#if defined(V8_TARGET_BIG_ENDIAN)
+#error "CoroutineLocal keeps values narrower than a slot in its low bytes"
+#endif
+
+// The running coroutine's table, or null on a plain thread.
+extern thread_local uintptr_t* g_active_coroutine_slots;
+
+// The calling thread's own table.
+V8_BASE_EXPORT uintptr_t* ThreadTable();
+
+inline uintptr_t* ActiveTable() {
+  uintptr_t* table = g_active_coroutine_slots;
+  return table ? table : ThreadTable();
+}
+
+// A value of type T kept per coroutine. Reads and writes copy the value; no
+// reference to the storage is handed out.
+template <typename T>
+class CoroutineLocal {
+  static_assert(sizeof(T) <= sizeof(uintptr_t));
+  static_assert(std::is_trivially_copyable_v<T>);
+
+ public:
+  explicit constexpr CoroutineLocal(CoroutineSlot slot) : slot_(slot) {}
+  CoroutineLocal(const CoroutineLocal&) = delete;
+  CoroutineLocal& operator=(const CoroutineLocal&) = delete;
+
+  T Get() const {
+    T value;
+    memcpy(&value, &ActiveTable()[slot_], sizeof(T));
+    return value;
+  }
+  void Set(T value) const { memcpy(&ActiveTable()[slot_], &value, sizeof(T)); }
+
+  operator T() const { return Get(); }
+  CoroutineLocal& operator=(T value) {
+    Set(value);
+    return *this;
+  }
+
+ private:
+  const CoroutineSlot slot_;
+};
+
+}  // namespace v8_coroutine
+
+extern "C" {
+// V8_COROUTINE_PATCH_VERSION of the V8 this was built from.
+V8_BASE_EXPORT int v8_coroutine_patch_version();
+// Number of slots in a coroutine's table.
+V8_BASE_EXPORT size_t v8_coroutine_slot_count();
+// Fills a new coroutine's table with the values a new thread starts with,
+// except the stack bounds: `stack_start` is the highest address of the
+// coroutine's stack, `stack_limit` its lowest (guard page included).
+V8_BASE_EXPORT void v8_coroutine_slots_init(uintptr_t* slots,
+                                                 void* stack_start,
+                                                 void* stack_limit);
+// Makes `slots` the running coroutine's table; null selects the thread's own.
+V8_BASE_EXPORT void v8_coroutine_slots_use(uintptr_t* slots);
+// Number of jobs in the isolate's default microtask queue.
+size_t v8_coroutine_microtask_count(void* isolate);
+// The owner of the default queue's first job (see v8_coroutine_microtask_owner):
+// 0 for none, -1 when the queue is empty.
+intptr_t v8_coroutine_microtask_peek(void* isolate);
+// Moves the default queue's first job to the end of `to` (a v8::MicrotaskQueue
+// of the same isolate) and returns 1. Returns 0 when the queue is empty or the
+// isolate is terminating, and -1 when `to` is not empty or is running.
+// `*owner` is the job's continuation preserved embedder data when that is a
+// Smi, else 0.
+int v8_coroutine_microtask_take(void* isolate, void* to, intptr_t* owner);
+// Sets the continuation preserved embedder data that new jobs capture: the Smi
+// `owner`, or undefined for 0. Values must fit in 31 bits.
+void v8_coroutine_microtask_owner(void* isolate, intptr_t owner);
+}
+
+#endif  // V8_BASE_COROUTINE_LOCAL_H_
