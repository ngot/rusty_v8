+// Embedders: converts the value of a perfetto-style TRACE_EVENT argument to a type
+// the legacy tracing implementation can record.
+template <typename T>
+auto TraceArg(const T& value) {
+  using D = std::decay_t<T>;
+  if constexpr (std::is_same_v<D, bool> || std::is_floating_point_v<D>) {
+    return value;
+  } else if constexpr (std::is_enum_v<D>) {
+    return static_cast<int64_t>(value);
+  } else if constexpr (std::is_integral_v<D>) {
+    return static_cast<std::conditional_t<std::is_signed_v<D>, int64_t,
+                                          uint64_t>>(value);
+  } else if constexpr (std::is_convertible_v<D, const char*>) {
+    return static_cast<const char*>(value);
+  } else if constexpr (std::is_pointer_v<D>) {
+    return static_cast<const void*>(value);
+  } else if constexpr (std::is_convertible_v<D, std::string>) {
+    return TraceStringWithCopy(std::string(value).c_str());
+  } else {
+    return "unsupported";
+  }
+}
